PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# Razorpay (recommended standard names)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Optional aliases also supported by backend
# RAZORPAY_KEYID=
# RAZORPAY_ID=
# RAZORPAY_KEYSECRET=
# RAZORPAY_SECRET=
# RAZORPAY_LIVE_KEY_ID=
# RAZORPAY_LIVE_KEY_SECRET=
# RAZORPAY_TEST_KEY_ID=
# RAZORPAY_TEST_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional direct UPI fallback ID
UPI_ID=uft@upi

# Optional AI assistant
AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Google Sign-In
# Use the Google OAuth Web client ID, not the client secret.
GOOGLE_CLIENT_ID=1234567890-abc123def456ghi789jkl012mno345pq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional aliases supported by backend
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_WEB_CLIENT_ID=

# Optional Claude/Anthropic mode
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
