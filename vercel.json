{
  "version": 2,
  "builds": [
    {
      "src": "backend.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "assets/**",
          "*.html",
          "*.jpeg",
          "*.jpg",
          "*.png",
          "*.webp"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/backend.js"
    }
  ]
}
