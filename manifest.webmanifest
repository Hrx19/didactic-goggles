{
  "name": "HUMAIXO",
  "short_name": "HUMAIXO",
  "description": "AI-native learning, paid notes, learner dashboard, and admin studio in one web app.",
  "id": "/app",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#030014",
  "theme_color": "#0f172a",
  "categories": ["education", "productivity", "business"],
  "lang": "en-IN",
  "dir": "ltr",
  "icons": [
    {
      "src": "/logo.png?v=5",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.png?v=5",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Academy",
      "short_name": "Academy",
      "description": "Browse HUMAIXO courses.",
      "url": "/academy",
      "icons": [{ "src": "/logo.png?v=5", "sizes": "192x192" }]
    },
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "description": "Continue courses, notes, and learning progress.",
      "url": "/dashboard",
      "icons": [{ "src": "/logo.png?v=5", "sizes": "192x192" }]
    },
    {
      "name": "Admin Studio",
      "short_name": "Admin",
      "description": "Manage site content with owner access.",
      "url": "/admin",
      "icons": [{ "src": "/logo.png?v=5", "sizes": "192x192" }]
    }
  ]
}

