{
  "name": "HUMAIX ECHO REALM",
  "short_name": "Echo Realm",
  "description": "AI-native coding education, notes, dashboard, travel planning, and admin studio in one web app.",
  "id": "/app",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#030014",
  "theme_color": "#0f172a",
  "categories": ["education", "productivity", "business"],
  "lang": "en-IN",
  "dir": "ltr",
  "icons": [
    {
      "src": "/logo.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Academy",
      "short_name": "Academy",
      "description": "Browse HUMAIX ECHO REALM courses.",
      "url": "/academy",
      "icons": [{ "src": "/logo.png?v=3", "sizes": "192x192" }]
    },
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "description": "Continue courses, notes, and travel plans.",
      "url": "/dashboard",
      "icons": [{ "src": "/logo.png?v=3", "sizes": "192x192" }]
    },
    {
      "name": "Travel Planner",
      "short_name": "Travel",
      "description": "Plan learning trips and itineraries.",
      "url": "/travel",
      "icons": [{ "src": "/logo.png?v=3", "sizes": "192x192" }]
    },
    {
      "name": "Admin Studio",
      "short_name": "Admin",
      "description": "Manage site content with owner access.",
      "url": "/admin",
      "icons": [{ "src": "/logo.png?v=3", "sizes": "192x192" }]
    }
  ]
}

